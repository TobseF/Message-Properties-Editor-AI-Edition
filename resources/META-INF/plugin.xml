<idea-plugin>
    <id>github.tobsef.message.properties.editor.ai</id>
    <name>Message Properties Editor AI Edition</name>
    <category>Languages</category>
    <depends>com.intellij.modules.xml</depends>
    <description><![CDATA[
        <p>
        The split-pane editor for Java <code>.properties</code> resource bundles, now with <b>AI translations</b>.
        It has all the features of the original JetBrains <i>Resource Bundle Editor</i>, plus extras that
        come built in, such as automatic translation.
        </p>

        <h3>AI translation, your way</h3>
        <ul>
          <li><b>Bring your own key</b>: works with any OpenAI-compatible endpoint (OpenAI, NanoGPT, custom servers)</li>
          <li><b>Any model</b>: pick from the list the server returns, or enter one yourself</li>
          <li><b>Runs fully offline</b> with local models, e.g. LM Studio, so no data leaves your machine</li>
          <li><b>No vendor login</b>, no subscription, no account needed</li>
          <li>Translate missing values for a single key or for the <b>whole bundle</b> at once; placeholders like <code>{0}</code> or <code>%s</code> are kept, and every run can be undone in one step</li>
        </ul>

        <h3>Everything you know from the Resource Bundle Editor</h3>
        <ul>
          <li>Edit all locales of a key side by side</li>
          <li>Key tree in the Structure View, grouped by prefix</li>
          <li>Inspections for missing translations and unused keys, with quick fixes</li>
          <li>Rename keys, prefix groups and bundles; add new keys; copy a value to all locales</li>
          <li>Filter for incomplete keys and jump between locale files</li>
        </ul>

        <p><img src="https://raw.githubusercontent.com/TobseF/Message-Properties-Editor-AI-Edition/main/docs/screenshot_editor_1.png" alt="Resource bundle editor" width="800"/></p>
        <p><img src="https://raw.githubusercontent.com/TobseF/Message-Properties-Editor-AI-Edition/main/docs/screenshot_settings.png" alt="AI translation settings" width="800"/></p>

        <p>JetBrains moved the built-in Resource Bundle Editor to the obsolete plugins
        (<a href="https://youtrack.jetbrains.com/issue/IDEA-379833">IDEA-379833</a>). This plugin carries it forward.</p>
    ]]></description>
    <vendor email="public.tobse@gmail.com" url="https://github.com/TobseF/Message-Properties-Editor-AI-Edition">TobseF
    </vendor>

    <depends>com.intellij.properties</depends>
    <extensions defaultExtensionNs="com.intellij">

        <renameHandler
                implementation="com.intellij.lang.properties.refactoring.rename.ResourceBundleFromEditorRenameHandler"/>

        <localInspection language="Properties" shortName="IncompletePropertyBundleEditor" unfair="true"
                         bundle="messages.ResourceBundleEditorBundle"
                         key="incomplete.property.inspection.display.name"
                         groupKey="properties.files.inspection.group.display.name"
                         enabledByDefault="true" level="ERROR"
                         implementationClass="com.intellij.lang.properties.editor.inspections.incomplete.IncompletePropertyInspection"/>

        <applicationConfigurable parentId="tools" id="ResourceBundleEditor.AiTranslation"
                                 bundle="messages.ResourceBundleEditorBundle" key="ai.settings.display.name"
                                 instance="com.intellij.lang.properties.editor.ai.AiTranslationConfigurable"/>

        <fileEditorProvider id="ResourceBundle"
                            implementation="com.intellij.lang.properties.editor.ResourceBundleEditorProvider"/>

        <gotoRelatedProvider
                implementation="com.intellij.lang.properties.editor.GotoResourceBundleLocalizationsProvider"/>
        <gotoRelatedProvider implementation="com.intellij.lang.properties.editor.GotoPropertyDeclarationsProvider"/>

        <refactoring.copyHandler implementation="com.intellij.lang.properties.editor.PropertiesCopyHandlerEx"
                                 order="before properties"/>
    </extensions>

    <actions>
        <action id="ChooseNextSubsequentPropertyValueEditorAction"
                class="com.intellij.lang.properties.editor.ChooseSubsequentPropertyValueEditorAction$Next"
                use-shortcut-of="MethodDown"/>
        <action id="ChoosePrevSubsequentPropertyValueEditorAction"
                class="com.intellij.lang.properties.editor.ChooseSubsequentPropertyValueEditorAction$Prev"
                use-shortcut-of="MethodUp"/>
        <action id="NewPropertyAction" class="com.intellij.lang.properties.editor.NewPropertyAction">
            <add-to-group group-id="NewGroup" anchor="first"/>
        </action>
        <action id="GotoNextIncompletePropertyAction"
                class="com.intellij.lang.properties.editor.GotoNextIncompletePropertyAction"
                use-shortcut-of="GotoNextError"/>

        <action id="ResourceBundleEditorShowIntentions"
                class="com.intellij.lang.properties.editor.ResourceBundleEditorShowQuickFixesAction"
                use-shortcut-of="ShowIntentionActions"/>

    </actions>
    <resource-bundle>messages.ResourceBundleEditorBundle</resource-bundle>
</idea-plugin>
